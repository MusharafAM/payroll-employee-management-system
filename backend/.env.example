# Server
PORT=3000
GIN_MODE=debug

# Database (Supabase PgBouncer pooler — port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Asgardeo
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<your-org>

# JWT (not currently used — kept for future)
JWT_SECRET=change-this-to-a-random-string

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:5173

# Email (SMTP) — used for payslip delivery
# Gmail: use an App Password (https://myaccount.google.com/apppasswords)
# SendGrid: host=smtp.sendgrid.net, user=apikey, pass=<sendgrid-api-key>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
